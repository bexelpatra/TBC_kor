# DB 연결 (로컬 PostgreSQL → AWS RDS 이관 시 URL만 교체)
DATABASE_URL=postgresql+psycopg2://brain_core_kor:brain_core_kor@localhost:5432/brain_core_kor

# JWT
JWT_SECRET=change-me-in-prod
JWT_USER_MINUTES=20
JWT_ADMIN_MINUTES=240

# 이름 암호화/HMAC 키 (운영에서는 시크릿 매니저로 주입)
# AES 키: 32바이트 hex(64자), HMAC 키: 임의 길이 hex
NAME_AES_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
NAME_HMAC_KEY=0123456789abcdef0123456789abcdef

# 파일 저장 (로컬 FS → S3 이관 시 STORAGE_BACKEND=s3)
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
PUBLIC_BASE_URL=/files

# 이미지 정책
MAX_IMAGE_BYTES=10485760
IMAGE_MAX_LONG_EDGE=1280
MAX_IMAGES_PER_POST=5

# CORS (프론트 개발 서버)
CORS_ORIGINS=http://localhost:5173
