# DB 연결 (로컬 PostgreSQL → AWS RDS 이관 시 URL만 교체)
# docker compose 로 띄울 때는 compose 가 루트 .env 값으로 조립해 주입하므로 비워 두어도 된다.
# 비밀번호에 @ : / # ? 가 들어가면 URI 파싱이 깨지므로 퍼센트 인코딩할 것 (@ → %40).
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/brain_core_kor

# ── 아래 3개는 필수값이다 (config.py 에 기본값 없음) ──────────────
# 비어 있으면 기동 시 ValidationError 로 즉시 중단된다. 이는 의도된 동작으로,
# 키 누락을 모른 채 잘못된 키로 서비스가 도는 상황을 막기 위한 것이다.
#
# 예시값을 그대로 복사하지 말 것. 아래 명령으로 직접 생성한다:
#   JWT_SECRET     : openssl rand -hex 32
#   NAME_AES_KEY   : openssl rand -hex 32      # AES-256 = 32바이트 = hex 64자
#   NAME_HMAC_KEY  : openssl rand -hex 32
#
# ⚠️ NAME_AES_KEY 는 app_user.name_enc 와 app_user.student_number_enc 두 컬럼에
#    모두 쓰인다. 교체하려면 두 컬럼을 함께 재암호화해야 한다.

JWT_SECRET=
JWT_USER_MINUTES=20
JWT_ADMIN_MINUTES=240

NAME_AES_KEY=
NAME_HMAC_KEY=

# 파일 저장 (로컬 FS → S3 이관 시 STORAGE_BACKEND=s3)
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
PUBLIC_BASE_URL=/files

# 이미지 정책
MAX_IMAGE_BYTES=10485760
IMAGE_MAX_LONG_EDGE=1280
MAX_IMAGES_PER_POST=5

# CORS (프론트 개발 서버)
CORS_ORIGINS=http://localhost:5173
